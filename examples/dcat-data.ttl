@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix ex: <https://example.org/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
ex:dataset a dcat:Dataset;
  dct:title "Air-quality observations"@en;
  dct:description "Example metadata for an air-quality dataset."@en;
  dcat:distribution ex:csv .
ex:csv a dcat:Distribution;
  dcat:accessURL <https://example.org/data.csv> .
<https://example.org/data.csv> a rdfs:Resource .
