@prefix ex: <https://example.org/core-roadmap/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

# Future Core acceptance case; MoonSHACL 0.1.0 rejects sh:pattern/sh:flags.
ex:ProductCodeShape a sh:PropertyShape ;
  sh:targetNode ex:product ;
  sh:path ex:code ;
  sh:pattern "^SKU-[0-9]{4}$" ;
  sh:flags "i" .
