@prefix ex: <https://example.org/core-roadmap/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Separate lexical validation from ordering. Future acceptance case:
# Executable xsd:date lexical validation case for MoonSHACL 0.4.0.
ex:DateDatatypeShape a sh:PropertyShape ;
  sh:targetNode ex:datedRecord ;
  sh:path ex:date ;
  sh:datatype xsd:date .
