@prefix ex: <https://example.org/core-roadmap/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

# Values in these data files are valid xsd:dateTime literals with explicit Z.
# Keep comparison assertions independent from datatype validation below.
# Executable Core acceptance case for MoonSHACL 0.4.0.
ex:StrictStartShape a sh:PropertyShape ;
  sh:targetNode ex:interval ;
  sh:path ex:start ;
  sh:lessThan ex:end .

ex:InclusiveStartShape a sh:PropertyShape ;
  sh:targetNode ex:interval ;
  sh:path ex:inclusiveStart ;
  sh:lessThanOrEquals ex:inclusiveEnd .
