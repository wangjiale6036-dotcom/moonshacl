        ":j ;\n\t\t\tsh:value ex:k ;\n\t\t\tsh:resultPath ex:r ;\n\t\t\tsh:sourceShape ex:s4 ;\n\t\t\tsh:sourceConstraintComponent sh:C",
        "lassConstraintComponent\n\t\t]\n\t] ;\n\tmf:status sht:approved .\n  ",
